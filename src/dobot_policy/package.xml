<?xml version="1.0"?>
<package format="3">
  <name>dobot_policy</name>
  <version>0.1.0</version>
  <description>Closed-loop OpenPI policy deployment for Dobot Nova2.</description>
  <maintainer email="user@example.com">user</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>dobot_camera</exec_depend>
  <exec_depend>dobot_interfaces</exec_depend>
  <exec_depend>dobot_ros2</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
