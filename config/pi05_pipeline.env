# Dobot/OpenPI π0.5 pipeline profile.
# This file is valid for both Make and shell. Edit paths and task values here;
# normal operation should not require long command-line variable lists.

# ---------- ServoP collection ----------
SERVO_DATASET_ROOT=/home/ps/DZK_repos/dobot/dobot_nova2_ros2_driver/data/collections/servo_p_v3
SERVO_LEROBOT_DATASET_ROOT=/home/ps/DZK_repos/dobot/dobot_nova2_ros2_driver/data/collections/servo_p_v3/lerobot_pi05_servo_p_v3
SERVO_START_POSE_FILE=/home/ps/DZK_repos/dobot/dobot_nova2_ros2_driver/data/collections/servo_p_v3/servo_p_start_pose.json
SERVO_TASK='pick the pen and put it in the box'

# Make's generic data commands follow the same ServoP profile by default.
JOY_DATASET_ROOT=/home/ps/DZK_repos/dobot/dobot_nova2_ros2_driver/data/collections/servo_p_v2
JOY_LEROBOT_DATASET_ROOT=/home/ps/DZK_repos/dobot/dobot_nova2_ros2_driver/data/collections/servo_p_v2/lerobot_pi05_servo_p_v2
JOY_TASK_FILE=/home/ps/DZK_repos/dobot/dobot_nova2_ros2_driver/data/collections/servo_p_v2/current_task.txt
COLLECTION_START_POSE_FILE=/home/ps/DZK_repos/dobot/dobot_nova2_ros2_driver/data/collections/servo_p_v2/servo_p_start_pose.json

# ---------- OpenPI Docker training ----------
OPENPI_REPO_DIR=/home/ps/DZK_repos/openpi
OPENPI_DOBOT_DATASET_DIR=/home/ps/DZK_repos/dobot/dobot_nova2_ros2_driver/data/collections/servo_p_v2/lerobot_pi05_servo_p_v2
OPENPI_POLICY_CONFIG=pi05_dobot_pen_box_servo_p_action_only
OPENPI_EXP_NAME=dobot_pen_box_servo_p_action_only_v1_long
OPENPI_TRAIN_STEPS=1000000
OPENPI_TRAIN_SAVE_INTERVAL=1000
OPENPI_TRAIN_RESUME=true
OPENPI_TRAIN_OVERWRITE=false

# ---------- Real-robot deployment ----------
OPENPI_CHECKPOINT_DIR=/home/ps/DZK_repos/openpi-docker-data/checkpoints/pi05_dobot_pen_box_servo_p_action_only/dobot_pen_box_servo_p_action_only_v1_long/188000
OPENPI_CHECKPOINT_CONTAINER_DIR=/workspace/checkpoints/pi05_dobot_pen_box_servo_p_action_only/dobot_pen_box_servo_p_action_only_v1_long/188000
POLICY_START_POSE_FILE=/home/ps/DZK_repos/dobot/dobot_nova2_ros2_driver/data/collections/servo_p_v2/servo_p_start_pose.json
